{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment_perfil": "NO `model` KEY, ON PURPOSE (24/09/2026 — repodocs ADR-026). A pin written here cannot win: the account's server-managed settings outrank every local file. And `opus[1m]` was a version pin wearing a window suffix — the 1M variant existed only for the previous Opus, so every session was born on it while the catalog already offered the newer one. To pin a model again, NAME the version: \"model\": \"opus55\". The highest effortLevel a FILE accepts is 'xhigh'; use /effort max for a single session.",
  "effortLevel": "xhigh",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "permissions": {
    "_comment": "Permissoes do projeto - GitHub Desktop (yarn / TypeScript / Electron)",
    "defaultMode": "plan",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(yarn install:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn prettier:*)",
      "Bash(yarn markdownlint:*)",
      "Bash(yarn test:*)",
      "Bash(yarn compile:*)",
      "Bash(yarn build:*)",
      "Bash(yarn start:*)",
      "Bash(yarn cli:*)",
      "Bash(yarn validate-changelog:*)",
      "Bash(yarn validate-electron-version:*)",
      "Bash(yarn validate-macos-version:*)",
      "Bash(node -c:*)",
      "Bash(npx tsc:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(wget * | sh:*)",
      "Bash(wget * | bash:*)"
    ],
    "ask": [
      "Bash(sudo:*)",
      "Bash(yarn add:*)",
      "Bash(yarn remove:*)",
      "Bash(yarn upgrade:*)",
      "Bash(yarn clean-slate:*)",
      "Bash(yarn rebuild-hard:*)"
    ]
  }
}
